# Fakhra Panel — environment template. Copy to .env and edit:
#   cp .env.example .env
# Everything below is a placeholder or blank on purpose: never commit real
# credentials. The names match the design spec's configuration table (§8).

# Admin dashboard (/login) credentials. Both default to `admin` when unset
# (the panel boots and logs a warning) — set a real password before the host
# is reachable from the internet, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Session-signing key: when set, session tokens are signed with it; rotating
# it logs all users out. Leave blank to auto-generate (persisted in the DB at
# DATA_DIR) — the auto-generated default works fine out of the box. Generate
# one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# REQUIRED — public hostname used in every share link (port 443, TLS at the
# edge). On Railway: <your-app>.railway.app from the Networking tab.
# If blank: the panel logs an ERROR at startup and link/QR generation
# returns 500 until it is set.
PUBLIC_HOST=

# VPS mode: when true, Caddy serves PUBLIC_HOST itself with automatic HTTPS
# (Let's Encrypt, HTTP-01 on :80, site on :443) — PUBLIC_HOST must then be a
# bare hostname (no https://, no port). install.sh sets this for VPS installs.
# Default: false — plain :PORT listener for Railway/local behind an edge.
AUTO_TLS=false

# Public port. In the container it's the port Caddy listens on (Railway
# injects PORT automatically); in local uvicorn mode it's the panel's port.
# Default: 8080.
PORT=8080

# Where the SQLite DB, Xray config, install token and secret key live.
# Leave blank to auto-pick: /data when that directory exists (Railway volume),
# otherwise ./data.
DATA_DIR=

# Xray binary path. Leave as `xray` to use the one on PATH (the Docker image
# ships a pinned release; locally run scripts/fetch_xray.sh and point this at
# .bin/xray if needed).
XRAY_BIN=xray

# Cookie "Secure" flag. Defaults to true; set false ONLY for plain-HTTP local
# development (http://localhost), otherwise the login cookie won't stick.
COOKIE_SECURE=false

# Reserved for spec compatibility — currently unused by the code.
ENV=development
